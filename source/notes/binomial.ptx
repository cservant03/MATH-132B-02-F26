        <p>Calculate and interpret the standard deviation for the fledgling distribution.</p>
      </statement>
    </example>

    <example xml:id="ex-clinic">
      <title>Follow-up Visits</title>
      <statement>
        <p>Let <m>X</m> be the number of follow-up visits needed by a patient in a hypothetical program. Calculate the expected value and standard deviation using R.</p>
        
        <tabular row-headers="yes" halign="center" valign="middle"
         top="medium" bottom="medium" left="medium" right="medium">
          <row bottom="medium">
            <cell><m>x</m></cell>
            <cell>0</cell>
            <cell>1</cell>
            <cell>2</cell>
            <cell>3</cell>
          </row>
          <row>
            <cell><m>P(X=x)</m></cell>
